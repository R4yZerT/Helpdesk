{
  "name": "helpdesk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "web": "pnpm --filter web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "gen:types": "supabase gen types typescript --linked --schema public > shared/src/supabase.types.ts",
    "test": "pnpm -r test",
    "supa:start": "npx supabase start",
    "supa:stop": "npx supabase stop",
    "supa:reset": "npx supabase db reset",
    "supa:status": "npx supabase status",
    "supa:env": "bash scripts/supa-env.sh",
    "dev:local": "npx supabase start && bash scripts/supa-env.sh && docker compose -f docker-compose.dev.yml up --build",
    "dev:local:watch": "npx supabase start && bash scripts/supa-env.sh && docker compose -f docker-compose.dev.yml up --build --watch",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:watch": "docker compose -f docker-compose.dev.yml up --build --watch",
    "docker:prod": "docker compose up --build",
    "docker:down": "docker compose -f docker-compose.dev.yml down && docker compose down",
    "import:historico": "tsx scripts/import-historico.ts",
    "import:historico:push": "tsx scripts/import-historico.ts -- --push"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "opencode-autoskills": "^1.2.0",
    "prettier": "^3.3.0",
    "supabase": "^2.115.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "papaparse": "^5.7.0"
  }
}