# Supabase — proyecto stzcqexdivuzmfizvbwp (obtener en Dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://stzcqexdivuzmfizvbwp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_key...
# BETO (RF-22) — URL que el navegador/app usa para POST /classify.
# Local/dev: http://localhost:8001 (docker compose levanta el servicio `beto`).
# Prod: URL pública del servicio BETO (ej. https://beto.tu-dominio.com).
EXPO_PUBLIC_BETO_URL=http://localhost:8001
# Opcional para scripts locales
SUPABASE_ACCESS_TOKEN=sbp_...
# H7 — Sentry (observabilidad). Vacío = desactivado (no-op).
# EXPO_PUBLIC_SENTRY_DSN=https://...@o...ingest.sentry.io/...
