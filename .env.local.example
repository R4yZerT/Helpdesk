# Supabase LOCAL — generado por `npx supabase start` (ver `npx supabase status -o env`)
# Copia este archivo a .env y reemplaza valores con los reales de tu stack local.
#   npx supabase start
#   npx supabase status -o env   # copia ANON_KEY y SERVICE_ROLE_KEY
# O ejecuta el helper:  pnpm supa:env  (genera .env.local automáticamente)

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Nota: dentro de Docker `web-dev` llega a Supabase vía host.docker.internal:54321
# El navegador en el host también resuelve host.docker.internal (Docker Desktop añade entrada en /etc/hosts).
# Si prefieres, puedes usar http://127.0.0.1:54321 en .env y añadir NEXT_PUBLIC_ alias.
EXPO_PUBLIC_SUPABASE_ANON_KEY=[JWT_2]   # <-- pegar ANON_KEY de `supabase status -o env`
SUPABASE_SERVICE_ROLE_KEY=[JWT_2]  # opcional, solo para scripts/migraciones

# Supabase Studio (no requerido por la app, solo para debug)
# http://127.0.0.1:54323  — user: postgres / pass: ver `supabase status`
# Inbucket (emails)      http://127.0.0.1:54324
# DB directa             postgresql://postgres:postgres@127.0.0.1:54322/postgres
